<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Waifu Gallery | Image Generator</title>

    <style>
        /* ===== RESET ===== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0b0b10;
            color: #ffffff;
            font-family: Arial, sans-serif;
            min-height: 100vh;
        }

        /* ===== HEADER ===== */

        header {
            text-align: center;
            padding: 35px 15px;
            background: #13131c;
            border-bottom: 1px solid #252535;
        }

        header h1 {
            font-size: clamp(26px, 5vw, 42px);
            margin-bottom: 12px;
            letter-spacing: 1px;
        }

        header p {
            color: #a5a5b8;
            font-size: 14px;
        }

        /* ===== MAIN ===== */

        main {
            max-width: 1400px;
            margin: auto;
            padding: 25px;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }

        .toolbar h2 {
            font-size: 22px;
        }

        /* ===== BUTTON ===== */

        button {
            background: #8054ff;
            color: white;
            border: none;
            padding: 12px 22px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        button:hover {
            background: #6939f5;
            transform: translateY(-2px);
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        /* ===== GALLERY ===== */

        .gallery {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));
            gap: 22px;
        }

        .image-card {
            background: #171720;
            border: 1px solid #292936;
            border-radius: 14px;
            overflow: hidden;
            transition: transform 0.2s;
        }

        .image-card:hover {
            transform: translateY(-5px);
            border-color: #8054ff;
        }

        .image-card img {
            width: 100%;
            aspect-ratio: 3 / 4;
            object-fit: cover;
            display: block;
            background: #22222c;
        }

        .image-info {
            padding: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .image-info span {
            color: #b6b6c8;
            font-size: 13px;
        }

        .image-info a {
            color: #b49bff;
            text-decoration: none;
            font-size: 13px;
        }

        .image-info a:hover {
            text-decoration: underline;
        }

        /* ===== LOADING ===== */

        .status {
            text-align: center;
            padding: 60px 15px;
            color: #b6b6c8;
            font-size: 16px;
            grid-column: 1 / -1;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #292936;
            border-top: 4px solid #8054ff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ===== FOOTER ===== */

        footer {
            text-align: center;
            padding: 30px 15px;
            color: #77778b;
            font-size: 13px;
            margin-top: 30px;
        }

        /* ===== MOBILE ===== */

        @media (max-width: 600px) {
            main {
                padding: 15px;
            }

            .gallery {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
                gap: 12px;
            }

            .image-card img {
                aspect-ratio: 3 / 4;
            }

            .image-info {
                padding: 10px;
            }

            .toolbar h2 {
                font-size: 18px;
            }

            button {
                padding: 10px 15px;
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->

    <header>
        <h1>Gallery</h1>
        <p>Refresh to get more.</p>
    </header>

    <!-- MAIN CONTENT -->

    <main>

        <div class="toolbar">

            <h2>Latest Images</h2>

            <button id="refreshBtn" onclick="loadImages()">
                ↻ Generate New Images
            </button>

        </div>

        <!-- Images from Python API will appear here -->

        <div class="gallery" id="gallery">

            <div class="status">
                <div class="spinner"></div>
                Loading your images...
            </div>

        </div>

    </main>

    <!-- FOOTER -->

    <footer>
        Powered by Python & Flask
    </footer>

    <!-- JAVASCRIPT -->

    <script>

        const gallery = document.getElementById("gallery");
        const refreshBtn = document.getElementById("refreshBtn");


        // Create loading animation

        function showLoading() {

            gallery.innerHTML = `
                <div class="status">
                    <div class="spinner"></div>
                    Generating your images...
                </div>
            `;

        }


        // Fetch images from Python

        async function loadImages() {

            refreshBtn.disabled = true;
            refreshBtn.textContent = "Loading...";

            showLoading();

            try {

                // Request 5 images from Flask
                const response = await fetch("/api/images", {
                    cache: "no-store"
                });

                if (!response.ok) {
                    throw new Error("Python API request failed");
                }

                // Convert response into JSON
                const data = await response.json();

                // Clear old images
                gallery.innerHTML = "";

                // Check if images exist
                if (!data.images || data.images.length === 0) {

                    gallery.innerHTML = `
                        <div class="status">
                            No images found.
                        </div>
                    `;

                    return;
                }

                // Create an image card for every URL
                data.images.forEach((url, index) => {

                    const card = document.createElement("div");
                    card.className = "image-card";

                    const img = document.createElement("img");

                    img.src = url;
                    img.alt = `Generated image ${index + 1}`;
                    img.loading = "lazy";

                    // Image loading error
                    img.onerror = function () {
                        this.alt = "Image could not be loaded";
                        this.style.opacity = "0.4";
                    };

                    const info = document.createElement("div");
                    info.className = "image-info";

                    const label = document.createElement("span");
                    label.textContent = `Image ${index + 1}`;

                    const link = document.createElement("a");
                    link.href = url;
                    link.target = "_blank";
                    link.rel = "noopener noreferrer";
                    link.textContent = "Open ↗";

                    info.appendChild(label);
                    info.appendChild(link);

                    card.appendChild(img);
                    card.appendChild(info);

                    gallery.appendChild(card);

                });

            } catch (error) {

                console.error(error);

                gallery.innerHTML = `
                    <div class="status">
                        <h3>Unable to load images</h3>
                        <p>
                            Make sure your Python Flask server
                            is running and try again.
                        </p>
                    </div>
                `;

            } finally {

                refreshBtn.disabled = false;
                refreshBtn.textContent = "↻ Generate New Images";

            }

        }


        // Automatically fetch images on page load
        // This runs again whenever the user refreshes.

        window.addEventListener("DOMContentLoaded", loadImages);

    </script>

</body>
</html>
